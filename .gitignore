# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local settings
.claude/settings.local.json

# Original certificates (unblurred signatures) stay on this computer only;
# only the blurred previews are committed and published
src/assets/Certificates/*
!src/assets/Certificates/previews/

# Resume stays private (visitors use "Request CV" instead)
src/assets/Resume/

# Full-size project originals stay local; the site uses the web-sized copies in Projects/web
src/assets/Projects/*.png
src/assets/Projects/CashTrack/

# Full-size originals of site images (the site uses optimized .webp copies)
image-originals/
